APP_NAME="The New Age Marketplace"
APP_ENV=local
APP_URL=http://localhost:8000
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_CURRENCY=USD
APP_CURRENCY_SYMBOL="$"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thenewage
DB_USERNAME=root
DB_PASSWORD=

MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@thenewage.local
MAIL_FROM_NAME="${APP_NAME}"

PAYMENT_PROVIDER=test
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
STRIPE_SECRET_KEY=

SECURITY_SESSION_LIFETIME=120
SECURITY_LOGIN_ATTEMPTS=5
SECURITY_LOGIN_DECAY=900
