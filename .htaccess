# Use this .htaccess when the project is extracted directly into public_html.
# It routes all web traffic into the public/ folder without changing the document root.

RewriteEngine On
RewriteBase /

# Allow the web installer to be reached at /install
RewriteRule ^install$ public/install.php [QSA,L]

# Serve real files and directories from the public/ folder
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
RewriteRule ^(.*)$ public/$1 [QSA,L]

# Everything else goes through the public/index.php front controller
RewriteRule ^(.*)$ public/index.php [QSA,L]

# Deny access to sensitive dot files
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Disable directory browsing
Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, X-Requested-With"
</IfModule>
